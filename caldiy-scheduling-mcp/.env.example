# Copy to .env and fill in your values. Never commit .env to git.

CAL_API_URL=http://localhost:5555
CAL_API_KEY=your-caldiy-api-key-here

MCP_PROFILE=public           # public | owner
MCP_TRANSPORT=stdio          # stdio | http
MCP_HTTP_PORT=3333
MCP_HTTP_BEARER_TOKEN=       # required if MCP_TRANSPORT=http

POLICY_FILE=./policy.yaml
DATA_DIR=./data
DRY_RUN=false
NOTIFY_WEBHOOK_URL=          # optional
